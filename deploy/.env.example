# Starwake settings. install.sh writes the real .env (mode 600) from your answers.
# Nothing here is secret, but .env is never committed (it names hosts on your LAN).

# --- where it runs -----------------------------------------------------------------------
PORT=8090                                   # host port (the container listens on 8080)
STARWAKE_HOSTNAME=starwake.citus.cloud      # the name players type; for messages/DNS only
STARWAKE_IMAGE=ghcr.io/ennissh/starwake
STARWAKE_TAG=latest                         # latest = every build; or an exact X.Y.Z-N
STARWAKE_CONTAINER=starwake
STARWAKE_DATA=/opt/docker/starwake/data     # saves, profiles, translator logs (uid 1000)

# --- translator (alien dialogue) ---------------------------------------------------------
LLM_MODE=ollama                             # ollama · mock (canned replies) · off (scripted only)
OLLAMA_URL=                                 # e.g. http://mac-studio.lan:11434 (asked by install.sh)
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_MS=20000
LLM_TEMPERATURE=0.7
CONTENT_RATING=mature                       # everyone · teen · mature · adult (never explicit)

# --- server --------------------------------------------------------------------------------
LOG_LEVEL=info
